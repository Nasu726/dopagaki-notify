{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopagaki-notify",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dopagaki-notify",
      "database_id": "ef0e68ff-4cbb-4b67-b5e8-62446c62e35f",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}

{
  "name": "dopagaki-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --experimental-sqlite --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "bundle:check": "wrangler deploy --dry-run --outdir .wrangler/ci-bundle",
    "setup:actions": "node ops/create-actions-settings.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}

{
  "name": "dopagaki-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --experimental-sqlite --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "bundle:check": "wrangler deploy --dry-run --outdir .wrangler/ci-bundle",
    "setup:actions": "node ops/setup-actions.mjs",
    "setup:cloudflare": "node ops/setup-cloudflare.mjs",
    "config:check": "node --experimental-strip-types ops/config-preflight.mjs",
    "predeploy": "npm run config:check",
    "smoke": "node --experimental-strip-types ops/manual-smoke.mjs",
    "inspect:discord": "node ops/inspect-discord-embed.mjs",
    "poll:request": "node ops/request-production-poll.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
